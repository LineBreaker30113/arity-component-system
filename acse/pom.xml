<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.halim</groupId>
        <artifactId>the-acs-project</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>acse</artifactId>
    <packaging>jar</packaging>

    <name>ACSE</name>
    <description>
        Few good implementations of the ACS contracts for solidifying the project.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.halim</groupId>
            <artifactId>acs</artifactId>
        </dependency>

        <!-- One of the engine's two runtime dependencies, with RoaringBitmap below. Everything else
             it uses is acs and the JDK. Keep it that way: this is a library meant to be embedded, so every
             dependency added here is one its consumers inherit. -->
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
        </dependency>

        <!-- The engine's second runtime dependency, for the Roaring-backed identity sets: a 481 KB
             jar with no dependencies of its own. -->
        <dependency>
            <groupId>org.roaringbitmap</groupId>
            <artifactId>RoaringBitmap</artifactId>
        </dependency>

        <!-- Test only. Versions match OntoDirectory's, so a test moved between the two projects
             behaves identically. No mocking framework, deliberately: call counting is done with
             java.lang.reflect.Proxy, the technique OntologyServiceProxy already uses. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
